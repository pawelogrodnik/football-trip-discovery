# Frontend - Football Trip Discovery
# Copy to .env.local and fill

# SMTP for /api/support (contact & bug report)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM=noreply@football-trip-discovery.example.com
SUPPORT_RECIPIENT=support@football-trip-discovery.example.com

# Fixtures sync (backend repo -> frontend/app/fixtures)
# Direct repository mirror; no backend HTTP API is used.
# The scheduled sync checks out pawelogrodnik/redesigned-broccoli@main and
# mirrors its committed fixtures/** tree. In GitHub Actions the backend
# checkout uses the BACKEND_REPO_TOKEN secret (fine-grained PAT with
# Contents: Read on pawelogrodnik/redesigned-broccoli).
