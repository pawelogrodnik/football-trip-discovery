# Frontend - Football Trip Discovery
# Copy to .env.local and fill

# SMTP for /api/support (contact & bug report)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM=noreply@football-trip-discovery.example.com
SUPPORT_RECIPIENT=support@football-trip-discovery.example.com

# Fixtures sync (backend -> frontend/app/fixtures)
# Used by npm run sync:fixtures and GitHub Actions fixtures-sync.yml
FIXTURES_SYNC_API_URL=http://localhost:4000
FIXTURES_SYNC_API_KEY=dev-secret-key
# Optional: where to write fixtures (default app/fixtures)
# FIXTURES_SYNC_TARGET_DIR=app/fixtures
